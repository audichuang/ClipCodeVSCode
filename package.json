{
  "name": "clipcode-vscode",
  "displayName": "Snipcode",
  "description": "Copy and restore files in the IntelliJ ClipCode clipboard format, plus Snipcode Git workbench, commit graph, and inline blame.",
  "version": "0.3.42",
  "publisher": "audichuang",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/audichuang/ClipCodeVSCode.git"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:clipcode.copyToClipboard",
    "onCommand:clipcode.copyAllOpenEditors",
    "onCommand:clipcode.copyGitChanges",
    "onCommand:clipcode.pasteAndRestoreFiles",
    "onView:clipcode.history",
    "onStartupFinished",
    "onCommand:clipcode.blame.toggle"
  ],
  "main": "./dist/extension.js",
  "l10n": "./graph/l10n",
  "contributes": {
    "commands": [
      {
        "command": "clipcode.copyToClipboard",
        "title": "%cmd.clipcode.copyToClipboard.title%",
        "category": "%category.snipcode%"
      },
      {
        "command": "clipcode.copyAllOpenEditors",
        "title": "%cmd.clipcode.copyAllOpenEditors.title%",
        "category": "%category.snipcode%"
      },
      {
        "command": "clipcode.copyGitChanges",
        "title": "%cmd.clipcode.copyGitChanges.title%",
        "category": "%category.snipcode%",
        "icon": "$(clippy)"
      },
      {
        "command": "clipcode.pasteAndRestoreFiles",
        "title": "%cmd.clipcode.pasteAndRestoreFiles.title%",
        "category": "%category.snipcode%"
      },
      {
        "command": "clipcode.history.switchRepository",
        "title": "%cmd.clipcode.history.switchRepository.title%",
        "category": "%category.snipcode%",
        "icon": "$(repo)"
      },
      {
        "command": "clipcode.history.copyFullSource",
        "title": "%cmd.clipcode.history.copyFullSource.title%",
        "category": "%category.snipcode%"
      },
      {
        "command": "clipcode.history.loadMore",
        "title": "%cmd.clipcode.history.loadMore.title%",
        "category": "%category.snipcode%"
      },
      {
        "command": "clipcode.history.refresh",
        "title": "%cmd.clipcode.history.refresh.title%",
        "category": "%category.snipcode%",
        "icon": "$(refresh)"
      },
      {
        "command": "gitGraphPlus.open",
        "title": "%cmd.gitGraphPlus.open.title%",
        "category": "%category.gitGraph%",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitGraphPlus.refresh",
        "title": "%cmd.gitGraphPlus.refresh.title%",
        "category": "%category.gitGraph%",
        "icon": "$(refresh)"
      },
      {
        "command": "gitGraphPlus.fetch",
        "title": "%cmd.gitGraphPlus.fetch.title%",
        "category": "%category.gitGraph%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitGraphPlus.pull",
        "title": "%cmd.gitGraphPlus.pull.title%",
        "category": "%category.gitGraph%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitGraphPlus.push",
        "title": "%cmd.gitGraphPlus.push.title%",
        "category": "%category.gitGraph%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitGraphPlus.publishBranch",
        "title": "%cmd.gitGraphPlus.publishBranch.title%",
        "category": "%category.gitGraph%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitGraphPlus.checkoutBranch",
        "title": "%cmd.gitGraphPlus.checkoutBranch.title%",
        "category": "%category.gitGraph%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gitGraphPlus.createBranch",
        "title": "%cmd.gitGraphPlus.createBranch.title%",
        "category": "%category.gitGraph%",
        "icon": "$(add)"
      },
      {
        "command": "gitGraphPlus.stashSave",
        "title": "%cmd.gitGraphPlus.stashSave.title%",
        "category": "%category.gitGraph%",
        "icon": "$(archive)"
      },
      {
        "command": "gitGraphPlus.createTag",
        "title": "%cmd.gitGraphPlus.createTag.title%",
        "category": "%category.gitGraph%",
        "icon": "$(tag)"
      },
      {
        "command": "gitGraphPlus.pushTag",
        "title": "%cmd.gitGraphPlus.pushTag.title%",
        "category": "%category.gitGraph%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitGraphPlus.pushAllTags",
        "title": "%cmd.gitGraphPlus.pushAllTags.title%",
        "category": "%category.gitGraph%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitGraphPlus.deleteRemoteTag",
        "title": "%cmd.gitGraphPlus.deleteRemoteTag.title%",
        "category": "%category.gitGraph%",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphPlus.deleteBranch",
        "title": "%cmd.gitGraphPlus.deleteBranch.title%",
        "category": "%category.gitGraph%",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphPlus.renameBranch",
        "title": "%cmd.gitGraphPlus.renameBranch.title%",
        "category": "%category.gitGraph%",
        "icon": "$(edit)"
      },
      {
        "command": "gitGraphPlus.deleteTag",
        "title": "%cmd.gitGraphPlus.deleteTag.title%",
        "category": "%category.gitGraph%",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphPlus.mergeBranch",
        "title": "%cmd.gitGraphPlus.mergeBranch.title%",
        "category": "%category.gitGraph%",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitGraphPlus.showRemoteBranchMenu",
        "title": "%cmd.gitGraphPlus.showRemoteBranchMenu.title%",
        "category": "%category.gitGraph%",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitGraphPlus.checkoutRemoteBranch",
        "title": "%cmd.gitGraphPlus.checkoutRemoteBranch.title%",
        "category": "%category.gitGraph%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gitGraphPlus.deleteRemoteBranch",
        "title": "%cmd.gitGraphPlus.deleteRemoteBranch.title%",
        "category": "%category.gitGraph%",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphPlus.stashApply",
        "title": "%cmd.gitGraphPlus.stashApply.title%",
        "category": "%category.gitGraph%",
        "icon": "$(check)"
      },
      {
        "command": "gitGraphPlus.stashPop",
        "title": "%cmd.gitGraphPlus.stashPop.title%",
        "category": "%category.gitGraph%",
        "icon": "$(check-all)"
      },
      {
        "command": "gitGraphPlus.stashDrop",
        "title": "%cmd.gitGraphPlus.stashDrop.title%",
        "category": "%category.gitGraph%",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphPlus.openWorktree",
        "title": "%cmd.gitGraphPlus.openWorktree.title%",
        "category": "%category.gitGraph%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitGraphPlus.openWorktreeInFileExplorer",
        "title": "%cmd.gitGraphPlus.openWorktreeInFileExplorer.title%",
        "category": "%category.gitGraph%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "gitGraphPlus.removeWorktree",
        "title": "%cmd.gitGraphPlus.removeWorktree.title%",
        "category": "%category.gitGraph%",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphPlus.addWorktree",
        "title": "%cmd.gitGraphPlus.addWorktree.title%",
        "category": "%category.gitGraph%",
        "icon": "$(add)"
      },
      {
        "command": "gitGraphPlus.pruneWorktrees",
        "title": "%cmd.gitGraphPlus.pruneWorktrees.title%",
        "category": "%category.gitGraph%",
        "icon": "$(clear-all)"
      },
      {
        "command": "clipcode.blame.toggle",
        "title": "%cmd.clipcode.blame.toggle.title%",
        "category": "%category.snipcode%",
        "icon": "$(git-commit)"
      },
      {
        "command": "clipcode.blame.revealCommit",
        "title": "%cmd.clipcode.blame.revealCommit.title%",
        "category": "%category.snipcode%"
      },
      {
        "command": "snipcode.git.stage",
        "title": "%cmd.snipcode.git.stage.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(check-all)"
      },
      {
        "command": "snipcode.git.unstage",
        "title": "%cmd.snipcode.git.unstage.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(clear-all)"
      },
      {
        "command": "snipcode.git.stageRepo",
        "title": "%cmd.snipcode.git.stageRepo.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(check-all)"
      },
      {
        "command": "snipcode.git.unstageRepo",
        "title": "%cmd.snipcode.git.unstageRepo.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(clear-all)"
      },
      {
        "command": "snipcode.git.copyAsClipCode",
        "title": "%cmd.snipcode.git.copyAsClipCode.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(clippy)"
      },
      {
        "command": "snipcode.git.copyBranchSeries",
        "title": "%cmd.snipcode.git.copyBranchSeries.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(git-branch)"
      },
      {
        "command": "snipcode.git.copyBranchSeriesFull",
        "title": "%cmd.snipcode.git.copyBranchSeriesFull.title%",
        "category": "%category.snipcodeGit%"
      },
      {
        "command": "snipcode.git.pasteBranchSeries",
        "title": "%cmd.snipcode.git.pasteBranchSeries.title%",
        "category": "%category.snipcodeGit%"
      },
      {
        "command": "snipcode.git.stageAll",
        "title": "%cmd.snipcode.git.stageAll.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(check-all)"
      },
      {
        "command": "snipcode.git.unstageAll",
        "title": "%cmd.snipcode.git.unstageAll.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(clear-all)"
      },
      {
        "command": "snipcode.git.refresh",
        "title": "%cmd.snipcode.git.refresh.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(refresh)"
      },
      {
        "command": "snipcode.git.fetchAll",
        "title": "%cmd.snipcode.git.fetchAll.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "snipcode.git.pullAll",
        "title": "%cmd.snipcode.git.pullAll.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "snipcode.git.pushAll",
        "title": "%cmd.snipcode.git.pushAll.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "snipcode.git.filterRepos",
        "title": "%cmd.snipcode.git.filterRepos.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(filter)"
      },
      {
        "command": "snipcode.git.filterReposActive",
        "title": "%cmd.snipcode.git.filterReposActive.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(filter-filled)"
      },
      {
        "command": "snipcode.git.showDiff",
        "title": "%cmd.snipcode.git.showDiff.title%",
        "category": "%category.snipcodeGit%"
      },
      {
        "command": "snipcode.git.openChange",
        "title": "%cmd.snipcode.git.openChange.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "snipcode.git.openChangeNative",
        "title": "%cmd.snipcode.git.openChangeNative.title%",
        "category": "%category.snipcodeGit%"
      },
      {
        "command": "snipcode.git.markResolved",
        "title": "%cmd.snipcode.git.markResolved.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(check)"
      },
      {
        "command": "snipcode.git.discard",
        "title": "%cmd.snipcode.git.discard.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(discard)"
      },
      {
        "command": "snipcode.git.discardRepo",
        "title": "%cmd.snipcode.git.discardRepo.title%",
        "category": "%category.snipcodeGit%",
        "icon": "$(discard)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "snipcode-git",
          "title": "%viewsContainer.snipcode-git.title%",
          "icon": "images/snipcode-git.svg"
        }
      ]
    },
    "views": {
      "snipcode-git": [
        {
          "id": "snipcode.changes",
          "name": "%view.snipcode.changes.name%",
          "initialSize": 3
        },
        {
          "id": "snipcode.commitBox",
          "name": "%view.snipcode.commitBox.name%",
          "type": "webview",
          "initialSize": 1
        },
        {
          "id": "snipcode.recentCommits",
          "name": "%view.snipcode.recentCommits.name%",
          "type": "webview",
          "initialSize": 2
        }
      ],
      "scm": [
        {
          "id": "clipcode.history",
          "name": "%view.clipcode.history.name%",
          "icon": "$(history)"
        },
        {
          "id": "gitGraphPlus.branches",
          "name": "%view.gitGraphPlus.branches.name%",
          "icon": "$(git-branch)",
          "visibility": "visible"
        },
        {
          "id": "gitGraphPlus.remotes",
          "name": "%view.gitGraphPlus.remotes.name%",
          "icon": "$(cloud)",
          "visibility": "collapsed"
        },
        {
          "id": "gitGraphPlus.tags",
          "name": "%view.gitGraphPlus.tags.name%",
          "icon": "$(tag)",
          "visibility": "collapsed"
        },
        {
          "id": "gitGraphPlus.stashes",
          "name": "%view.gitGraphPlus.stashes.name%",
          "icon": "$(archive)",
          "visibility": "collapsed"
        },
        {
          "id": "gitGraphPlus.worktrees",
          "name": "%view.gitGraphPlus.worktrees.name%",
          "icon": "$(worktree)",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitGraphPlus.branches",
        "contents": "%viewsWelcome.0.contents%"
      },
      {
        "view": "snipcode.changes",
        "contents": "%viewsWelcome.1.contents%",
        "when": "snipcode.changes.hasRepos"
      },
      {
        "view": "snipcode.changes",
        "contents": "%viewsWelcome.2.contents%",
        "when": "!snipcode.changes.hasRepos"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gitGraphPlus.open",
          "group": "navigation",
          "when": "gitOpenRepositoryCount != 0"
        },
        {
          "command": "clipcode.blame.toggle",
          "group": "navigation",
          "when": "editorIsOpen && gitOpenRepositoryCount != 0"
        }
      ],
      "scm/title": [
        {
          "command": "gitGraphPlus.open",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "explorer/context": [
        {
          "command": "clipcode.copyToClipboard",
          "group": "navigation@20"
        },
        {
          "command": "clipcode.pasteAndRestoreFiles",
          "group": "navigation@21"
        }
      ],
      "editor/title/context": [
        {
          "command": "clipcode.copyAllOpenEditors",
          "group": "navigation@20"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "clipcode.copyGitChanges",
          "when": "scmProvider == git",
          "group": "navigation@20"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "clipcode.copyGitChanges",
          "when": "scmProvider == git",
          "group": "navigation@20"
        }
      ],
      "view/title": [
        {
          "command": "snipcode.git.filterRepos",
          "when": "view == snipcode.changes && !snipcode.changes.filtered",
          "group": "navigation@0"
        },
        {
          "command": "snipcode.git.filterReposActive",
          "when": "view == snipcode.changes && snipcode.changes.filtered",
          "group": "navigation@0"
        },
        {
          "command": "snipcode.git.stageAll",
          "when": "view == snipcode.changes",
          "group": "1_bulk@1"
        },
        {
          "command": "snipcode.git.unstageAll",
          "when": "view == snipcode.changes",
          "group": "1_bulk@2"
        },
        {
          "command": "snipcode.git.refresh",
          "when": "view == snipcode.changes",
          "group": "1_bulk@3"
        },
        {
          "command": "snipcode.git.fetchAll",
          "when": "view == snipcode.changes",
          "group": "navigation@1"
        },
        {
          "command": "snipcode.git.pullAll",
          "when": "view == snipcode.changes",
          "group": "navigation@2"
        },
        {
          "command": "snipcode.git.pushAll",
          "when": "view == snipcode.changes",
          "group": "navigation@3"
        },
        {
          "command": "gitGraphPlus.open",
          "when": "view == snipcode.changes",
          "group": "navigation@4"
        },
        {
          "command": "clipcode.history.switchRepository",
          "when": "view == clipcode.history",
          "group": "navigation@10"
        },
        {
          "command": "clipcode.history.refresh",
          "when": "view == clipcode.history",
          "group": "navigation@20"
        },
        {
          "command": "gitGraphPlus.open",
          "when": "view =~ /^gitGraphPlus/",
          "group": "navigation@1"
        },
        {
          "command": "gitGraphPlus.refresh",
          "when": "view =~ /^gitGraphPlus/",
          "group": "navigation@2"
        },
        {
          "command": "gitGraphPlus.fetch",
          "when": "view == gitGraphPlus.branches || view == gitGraphPlus.remotes",
          "group": "navigation@3"
        },
        {
          "command": "gitGraphPlus.pull",
          "when": "view == gitGraphPlus.branches",
          "group": "navigation@4"
        },
        {
          "command": "gitGraphPlus.push",
          "when": "view == gitGraphPlus.branches && gitGraphPlus.currentBranchHasUpstream != false",
          "group": "navigation@5"
        },
        {
          "command": "gitGraphPlus.publishBranch",
          "when": "view == gitGraphPlus.branches && gitGraphPlus.currentBranchHasUpstream == false",
          "group": "navigation@5"
        },
        {
          "command": "gitGraphPlus.createBranch",
          "when": "view == gitGraphPlus.branches",
          "group": "navigation@6"
        },
        {
          "command": "gitGraphPlus.createTag",
          "when": "view == gitGraphPlus.tags",
          "group": "navigation@3"
        },
        {
          "command": "gitGraphPlus.pushAllTags",
          "when": "view == gitGraphPlus.tags",
          "group": "navigation@4"
        },
        {
          "command": "gitGraphPlus.stashSave",
          "when": "view == gitGraphPlus.stashes",
          "group": "navigation@3"
        },
        {
          "command": "gitGraphPlus.addWorktree",
          "when": "view == gitGraphPlus.worktrees",
          "group": "navigation@3"
        },
        {
          "command": "gitGraphPlus.pruneWorktrees",
          "when": "view == gitGraphPlus.worktrees",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "snipcode.git.stage",
          "when": "view == snipcode.changes && viewItem == file-unstaged",
          "group": "inline"
        },
        {
          "command": "snipcode.git.discard",
          "when": "view == snipcode.changes && viewItem == file-unstaged",
          "group": "inline"
        },
        {
          "command": "snipcode.git.unstage",
          "when": "view == snipcode.changes && viewItem == file-staged",
          "group": "inline"
        },
        {
          "command": "snipcode.git.markResolved",
          "when": "view == snipcode.changes && viewItem == file-conflict",
          "group": "inline"
        },
        {
          "command": "snipcode.git.openChange",
          "when": "view == snipcode.changes && viewItem =~ /^file-/",
          "group": "inline@9"
        },
        {
          "command": "snipcode.git.stageRepo",
          "when": "view == snipcode.changes && viewItem == repo-unstaged",
          "group": "inline"
        },
        {
          "command": "snipcode.git.discardRepo",
          "when": "view == snipcode.changes && viewItem == repo-unstaged",
          "group": "inline"
        },
        {
          "command": "snipcode.git.unstageRepo",
          "when": "view == snipcode.changes && viewItem == repo-staged",
          "group": "inline"
        },
        {
          "command": "snipcode.git.stage",
          "when": "view == snipcode.changes && viewItem == file-unstaged",
          "group": "1_stage@1"
        },
        {
          "command": "snipcode.git.unstage",
          "when": "view == snipcode.changes && viewItem == file-staged",
          "group": "1_stage@1"
        },
        {
          "command": "snipcode.git.markResolved",
          "when": "view == snipcode.changes && viewItem == file-conflict",
          "group": "1_stage@1"
        },
        {
          "command": "snipcode.git.stageRepo",
          "when": "view == snipcode.changes && viewItem == repo-unstaged",
          "group": "1_stage@1"
        },
        {
          "command": "snipcode.git.unstageRepo",
          "when": "view == snipcode.changes && viewItem == repo-staged",
          "group": "1_stage@1"
        },
        {
          "command": "snipcode.git.openChange",
          "when": "view == snipcode.changes && viewItem =~ /^file-/",
          "group": "2_open@1"
        },
        {
          "command": "snipcode.git.showDiff",
          "when": "view == snipcode.changes && viewItem =~ /^file-/",
          "group": "2_open@2"
        },
        {
          "command": "snipcode.git.openChangeNative",
          "when": "view == snipcode.changes && viewItem =~ /^file-/",
          "group": "2_open@3"
        },
        {
          "command": "snipcode.git.discard",
          "when": "view == snipcode.changes && viewItem == file-unstaged",
          "group": "3_discard@1"
        },
        {
          "command": "snipcode.git.discardRepo",
          "when": "view == snipcode.changes && viewItem == repo-unstaged",
          "group": "3_discard@1"
        },
        {
          "command": "snipcode.git.copyAsClipCode",
          "when": "view == snipcode.changes && viewItem =~ /^(file|repo|group)-/",
          "group": "9_copy@1"
        },
        {
          "command": "clipcode.history.copyFullSource",
          "when": "view == clipcode.history && viewItem =~ /^(commit|folder|file)$/",
          "group": "navigation@10"
        },
        {
          "command": "gitGraphPlus.checkoutBranch",
          "when": "view == gitGraphPlus.branches && viewItem == branch",
          "group": "1_branch@1"
        },
        {
          "command": "gitGraphPlus.mergeBranch",
          "when": "view == gitGraphPlus.branches && viewItem == branch",
          "group": "1_branch@2"
        },
        {
          "command": "gitGraphPlus.renameBranch",
          "when": "view == gitGraphPlus.branches && viewItem == branch",
          "group": "1_branch@3"
        },
        {
          "command": "snipcode.git.copyBranchSeries",
          "when": "view == gitGraphPlus.branches && viewItem =~ /^branch(-current)?$/",
          "group": "1_branch@4"
        },
        {
          "command": "gitGraphPlus.deleteBranch",
          "when": "view == gitGraphPlus.branches && viewItem == branch",
          "group": "2_danger@1"
        },
        {
          "command": "gitGraphPlus.checkoutRemoteBranch",
          "when": "view == gitGraphPlus.remotes && viewItem == remote-branch",
          "group": "1_branch@1"
        },
        {
          "command": "gitGraphPlus.deleteRemoteBranch",
          "when": "view == gitGraphPlus.remotes && viewItem == remote-branch",
          "group": "2_danger@1"
        },
        {
          "command": "gitGraphPlus.checkoutBranch",
          "when": "view == gitGraphPlus.tags && viewItem == tag",
          "group": "0_checkout@1"
        },
        {
          "command": "gitGraphPlus.pushTag",
          "when": "view == gitGraphPlus.tags && viewItem == tag",
          "group": "1_push@1"
        },
        {
          "command": "gitGraphPlus.deleteRemoteTag",
          "when": "view == gitGraphPlus.tags && viewItem == tag",
          "group": "2_danger@1"
        },
        {
          "command": "gitGraphPlus.deleteTag",
          "when": "view == gitGraphPlus.tags && viewItem == tag",
          "group": "2_danger@2"
        },
        {
          "command": "gitGraphPlus.stashApply",
          "when": "view == gitGraphPlus.stashes && viewItem == stash",
          "group": "1_stash@1"
        },
        {
          "command": "gitGraphPlus.stashPop",
          "when": "view == gitGraphPlus.stashes && viewItem == stash",
          "group": "1_stash@2"
        },
        {
          "command": "gitGraphPlus.stashDrop",
          "when": "view == gitGraphPlus.stashes && viewItem == stash",
          "group": "2_danger@1"
        },
        {
          "command": "gitGraphPlus.openWorktree",
          "when": "view == gitGraphPlus.worktrees && (viewItem == worktree || viewItem == worktree-main)",
          "group": "1_worktree@1"
        },
        {
          "command": "gitGraphPlus.openWorktreeInFileExplorer",
          "when": "view == gitGraphPlus.worktrees && (viewItem == worktree || viewItem == worktree-main)",
          "group": "1_worktree@2"
        },
        {
          "command": "gitGraphPlus.removeWorktree",
          "when": "view == gitGraphPlus.worktrees && viewItem == worktree",
          "group": "2_danger@1"
        }
      ],
      "commandPalette": [
        {
          "command": "snipcode.git.stage",
          "when": "false"
        },
        {
          "command": "snipcode.git.unstage",
          "when": "false"
