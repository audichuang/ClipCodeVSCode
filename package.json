{
  "name": "clipcode-vscode",
  "displayName": "Snipcode",
  "description": "Copy and restore files in the IntelliJ ClipCode clipboard format, plus Snipcode Git workbench, commit graph, and inline blame.",
  "version": "0.3.42",
  "publisher": "audichuang",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/audichuang/ClipCodeVSCode.git"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:clipcode.copyToClipboard",
    "onCommand:clipcode.copyAllOpenEditors",
    "onCommand:clipcode.copyGitChanges",
    "onCommand:clipcode.pasteAndRestoreFiles",
    "onView:clipcode.history",
    "onStartupFinished",
    "onCommand:clipcode.blame.toggle"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "clipcode.copyToClipboard",
        "title": "Copy to Clipboard",
        "category": "Snipcode"
      },
      {
        "command": "clipcode.copyAllOpenEditors",
        "title": "Copy All Open Editors",
        "category": "Snipcode"
      },
      {
        "command": "clipcode.copyGitChanges",
        "title": "Copy Git Changes",
        "category": "Snipcode",
        "icon": "$(clippy)"
      },
      {
        "command": "clipcode.pasteAndRestoreFiles",
        "title": "Paste and Restore Files",
        "category": "Snipcode"
      },
      {
        "command": "clipcode.history.switchRepository",
        "title": "Switch Repository",
        "category": "Snipcode",
        "icon": "$(repo)"
      },
      {
        "command": "clipcode.history.copyFullSource",
        "title": "Copy Full Source",
        "category": "Snipcode"
      },
      {
        "command": "clipcode.history.loadMore",
        "title": "Load More",
        "category": "Snipcode"
      },
      {
        "command": "clipcode.history.refresh",
        "title": "Refresh",
        "category": "Snipcode",
        "icon": "$(refresh)"
      },
      {
        "command": "gitGraphPlus.open",
        "title": "Open Git Graph",
        "category": "Git Graph+",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitGraphPlus.refresh",
        "title": "Refresh",
        "category": "Git Graph+",
        "icon": "$(refresh)"
      },
      {
        "command": "gitGraphPlus.fetch",
        "title": "Fetch",
        "category": "Git Graph+",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitGraphPlus.pull",
        "title": "Pull",
        "category": "Git Graph+",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitGraphPlus.push",
        "title": "Push",
        "category": "Git Graph+",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitGraphPlus.publishBranch",
        "title": "Publish Branch",
        "category": "Git Graph+",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitGraphPlus.checkoutBranch",
        "title": "Checkout Branch",
        "category": "Git Graph+",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gitGraphPlus.createBranch",
        "title": "Create Branch",
        "category": "Git Graph+",
        "icon": "$(add)"
      },
      {
        "command": "gitGraphPlus.stashSave",
        "title": "Stash Changes",
        "category": "Git Graph+",
        "icon": "$(archive)"
      },
      {
        "command": "gitGraphPlus.createTag",
        "title": "Create Tag",
        "category": "Git Graph+",
        "icon": "$(tag)"
      },
      {
        "command": "gitGraphPlus.pushTag",
        "title": "Push Tag",
        "category": "Git Graph+",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitGraphPlus.pushAllTags",
        "title": "Push All Tags",
        "category": "Git Graph+",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitGraphPlus.deleteRemoteTag",
        "title": "Delete Remote Tag",
        "category": "Git Graph+",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphPlus.deleteBranch",
        "title": "Delete Branch",
        "category": "Git Graph+",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphPlus.renameBranch",
        "title": "Rename Branch",
        "category": "Git Graph+",
        "icon": "$(edit)"
      },
      {
        "command": "gitGraphPlus.deleteTag",
        "title": "Delete Tag",
        "category": "Git Graph+",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphPlus.mergeBranch",
        "title": "Merge Branch",
        "category": "Git Graph+",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitGraphPlus.showRemoteBranchMenu",
        "title": "Remote Branch Menu",
        "category": "Git Graph+",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitGraphPlus.checkoutRemoteBranch",
        "title": "Checkout Remote Branch",
        "category": "Git Graph+",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gitGraphPlus.deleteRemoteBranch",
        "title": "Delete Remote Branch",
        "category": "Git Graph+",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphPlus.stashApply",
        "title": "Apply Stash",
        "category": "Git Graph+",
        "icon": "$(check)"
      },
      {
        "command": "gitGraphPlus.stashPop",
        "title": "Pop Stash",
        "category": "Git Graph+",
        "icon": "$(check-all)"
      },
      {
        "command": "gitGraphPlus.stashDrop",
        "title": "Drop Stash",
        "category": "Git Graph+",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphPlus.openWorktree",
        "title": "Open Worktree",
        "category": "Git Graph+",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitGraphPlus.openWorktreeInFileExplorer",
        "title": "Reveal Worktree",
        "category": "Git Graph+",
        "icon": "$(folder-opened)"
      },
      {
        "command": "gitGraphPlus.removeWorktree",
        "title": "Remove Worktree",
        "category": "Git Graph+",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphPlus.addWorktree",
        "title": "Add Worktree",
        "category": "Git Graph+",
        "icon": "$(add)"
      },
      {
        "command": "gitGraphPlus.pruneWorktrees",
        "title": "Prune Worktrees",
        "category": "Git Graph+",
        "icon": "$(clear-all)"
      },
      {
        "command": "clipcode.blame.toggle",
        "title": "Toggle Inline Blame",
        "category": "Snipcode",
        "icon": "$(git-commit)"
      },
      {
        "command": "clipcode.blame.revealCommit",
        "title": "Reveal Blamed Commit in Graph",
        "category": "Snipcode"
      },
      {
        "command": "snipcode.git.stage",
        "title": "Stage",
        "category": "Snipcode Git",
        "icon": "$(add)"
      },
      {
        "command": "snipcode.git.unstage",
        "title": "Unstage",
        "category": "Snipcode Git",
        "icon": "$(remove)"
      },
      {
        "command": "snipcode.git.stageRepo",
        "title": "Stage All in Repo",
        "category": "Snipcode Git",
        "icon": "$(add)"
      },
      {
        "command": "snipcode.git.unstageRepo",
        "title": "Unstage All in Repo",
        "category": "Snipcode Git",
        "icon": "$(remove)"
      },
      {
        "command": "snipcode.git.copyAsClipCode",
        "title": "Copy as ClipCode",
        "category": "Snipcode Git",
        "icon": "$(clippy)"
      },
      {
        "command": "snipcode.git.copyBranchSeries",
        "title": "Copy Branch Commits",
        "category": "Snipcode Git",
        "icon": "$(git-branch)"
      },
      {
        "command": "snipcode.git.copyBranchSeriesFull",
        "title": "Copy Branch Commits (Entire History)",
        "category": "Snipcode Git"
      },
      {
        "command": "snipcode.git.pasteBranchSeries",
        "title": "Paste Branch Commits",
        "category": "Snipcode Git"
      },
      {
        "command": "snipcode.git.stageAll",
        "title": "Stage All",
        "category": "Snipcode Git",
        "icon": "$(add)"
      },
      {
        "command": "snipcode.git.unstageAll",
        "title": "Unstage All",
        "category": "Snipcode Git",
        "icon": "$(remove)"
      },
      {
        "command": "snipcode.git.refresh",
        "title": "Refresh",
        "category": "Snipcode Git",
        "icon": "$(refresh)"
      },
      {
        "command": "snipcode.git.fetchAll",
        "title": "Fetch All Repos",
        "category": "Snipcode Git",
        "icon": "$(cloud-download)"
      },
      {
        "command": "snipcode.git.pullAll",
        "title": "Pull All Repos",
        "category": "Snipcode Git",
        "icon": "$(arrow-down)"
      },
      {
        "command": "snipcode.git.pushAll",
        "title": "Push All Repos",
        "category": "Snipcode Git",
        "icon": "$(arrow-up)"
      },
      {
        "command": "snipcode.git.filterRepos",
        "title": "Filter Repos",
        "category": "Snipcode Git",
        "icon": "$(filter)"
      },
      {
        "command": "snipcode.git.showDiff",
        "title": "Show Diff",
        "category": "Snipcode Git"
      },
      {
        "command": "snipcode.git.openChange",
        "title": "Open in Editor",
        "category": "Snipcode Git",
        "icon": "$(go-to-file)"
      },
      {
        "command": "snipcode.git.openChangeNative",
        "title": "Open Changes (VS Code)",
        "category": "Snipcode Git"
      },
      {
        "command": "snipcode.git.markResolved",
        "title": "Mark Resolved",
        "category": "Snipcode Git",
        "icon": "$(check)"
      },
      {
        "command": "snipcode.git.discard",
        "title": "Discard Changes",
        "category": "Snipcode Git",
        "icon": "$(discard)"
      },
      {
        "command": "snipcode.git.discardRepo",
        "title": "Discard All in Repo",
        "category": "Snipcode Git",
        "icon": "$(discard)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "snipcode-git",
          "title": "Snipcode Git",
          "icon": "images/snipcode-git.svg"
        }
      ]
    },
    "views": {
      "snipcode-git": [
        {
          "id": "snipcode.changes",
          "name": "Changes"
        },
        {
          "id": "snipcode.commitBox",
          "name": "Commit",
          "type": "webview"
        }
      ],
      "scm": [
        {
          "id": "clipcode.history",
          "name": "Snipcode History",
          "icon": "$(history)"
        },
        {
          "id": "gitGraphPlus.branches",
          "name": "Branches",
          "icon": "$(git-branch)",
          "visibility": "visible"
        },
        {
          "id": "gitGraphPlus.remotes",
          "name": "Remotes",
          "icon": "$(cloud)"
        },
        {
          "id": "gitGraphPlus.tags",
          "name": "Tags",
          "icon": "$(tag)"
        },
        {
          "id": "gitGraphPlus.stashes",
          "name": "Stashes",
          "icon": "$(archive)"
        },
        {
          "id": "gitGraphPlus.worktrees",
          "name": "Worktrees",
          "icon": "$(worktree)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitGraphPlus.branches",
        "contents": "No git repository found.\n[Open Folder](command:vscode.openFolder)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gitGraphPlus.open",
          "group": "navigation"
        },
        {
          "command": "clipcode.blame.toggle",
          "group": "navigation",
          "when": "editorIsOpen"
        }
      ],
      "scm/title": [
        {
          "command": "gitGraphPlus.open",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "explorer/context": [
        {
          "command": "clipcode.copyToClipboard",
          "group": "navigation@20"
        },
        {
          "command": "clipcode.pasteAndRestoreFiles",
          "group": "navigation@21"
        }
      ],
      "editor/title/context": [
        {
          "command": "clipcode.copyAllOpenEditors",
          "group": "navigation@20"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "clipcode.copyGitChanges",
          "when": "scmProvider == git",
          "group": "navigation@20"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "clipcode.copyGitChanges",
          "when": "scmProvider == git",
          "group": "navigation@20"
        }
      ],
      "view/title": [
        {
          "command": "snipcode.git.filterRepos",
          "when": "view == snipcode.changes",
          "group": "navigation@0"
        },
        {
          "command": "snipcode.git.stageAll",
          "when": "view == snipcode.changes",
          "group": "navigation@1"
        },
        {
          "command": "snipcode.git.unstageAll",
          "when": "view == snipcode.changes",
          "group": "navigation@2"
        },
        {
          "command": "snipcode.git.refresh",
          "when": "view == snipcode.changes",
          "group": "navigation@3"
        },
        {
          "command": "snipcode.git.fetchAll",
          "when": "view == snipcode.changes",
          "group": "navigation@4"
        },
        {
          "command": "snipcode.git.pullAll",
          "when": "view == snipcode.changes",
          "group": "navigation@5"
        },
        {
          "command": "snipcode.git.pushAll",
          "when": "view == snipcode.changes",
          "group": "navigation@6"
        },
        {
          "command": "gitGraphPlus.open",
          "when": "view == snipcode.changes",
          "group": "navigation@7"
        },
        {
          "command": "clipcode.history.switchRepository",
          "when": "view == clipcode.history",
          "group": "navigation@10"
        },
        {
          "command": "clipcode.history.refresh",
          "when": "view == clipcode.history",
          "group": "navigation@20"
        },
        {
          "command": "gitGraphPlus.open",
          "when": "view =~ /^gitGraphPlus/",
          "group": "navigation@1"
        },
        {
          "command": "gitGraphPlus.refresh",
          "when": "view =~ /^gitGraphPlus/",
          "group": "navigation@2"
        },
        {
          "command": "gitGraphPlus.fetch",
          "when": "view == gitGraphPlus.branches || view == gitGraphPlus.remotes",
          "group": "navigation@3"
        },
        {
          "command": "gitGraphPlus.pull",
          "when": "view == gitGraphPlus.branches",
          "group": "navigation@4"
        },
        {
          "command": "gitGraphPlus.push",
          "when": "view == gitGraphPlus.branches && gitGraphPlus.currentBranchHasUpstream != false",
          "group": "navigation@5"
        },
        {
          "command": "gitGraphPlus.publishBranch",
          "when": "view == gitGraphPlus.branches && gitGraphPlus.currentBranchHasUpstream == false",
          "group": "navigation@5"
        },
        {
          "command": "gitGraphPlus.createBranch",
          "when": "view == gitGraphPlus.branches",
          "group": "navigation@6"
        },
        {
          "command": "gitGraphPlus.createTag",
          "when": "view == gitGraphPlus.tags",
          "group": "navigation@3"
        },
        {
          "command": "gitGraphPlus.pushAllTags",
          "when": "view == gitGraphPlus.tags",
          "group": "navigation@4"
        },
        {
          "command": "gitGraphPlus.stashSave",
          "when": "view == gitGraphPlus.stashes",
          "group": "navigation@3"
        },
        {
          "command": "gitGraphPlus.addWorktree",
          "when": "view == gitGraphPlus.worktrees",
          "group": "navigation@3"
        },
        {
          "command": "gitGraphPlus.pruneWorktrees",
          "when": "view == gitGraphPlus.worktrees",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "snipcode.git.stage",
          "when": "view == snipcode.changes && viewItem == file-unstaged",
          "group": "inline"
        },
        {
          "command": "snipcode.git.discard",
          "when": "view == snipcode.changes && viewItem == file-unstaged",
          "group": "inline"
        },
        {
          "command": "snipcode.git.unstage",
          "when": "view == snipcode.changes && viewItem == file-staged",
          "group": "inline"
        },
        {
          "command": "snipcode.git.markResolved",
          "when": "view == snipcode.changes && viewItem == file-conflict",
          "group": "inline"
        },
        {
          "command": "snipcode.git.openChange",
          "when": "view == snipcode.changes && viewItem =~ /^file-/",
          "group": "inline@9"
        },
        {
          "command": "snipcode.git.stageRepo",
          "when": "view == snipcode.changes && viewItem == repo-unstaged",
          "group": "inline"
        },
        {
          "command": "snipcode.git.discardRepo",
          "when": "view == snipcode.changes && viewItem == repo-unstaged",
          "group": "inline"
        },
        {
          "command": "snipcode.git.unstageRepo",
          "when": "view == snipcode.changes && viewItem == repo-staged",
          "group": "inline"
        },
        {
          "command": "snipcode.git.stage",
          "when": "view == snipcode.changes && viewItem == file-unstaged",
          "group": "1_stage@1"
        },
        {
          "command": "snipcode.git.unstage",
          "when": "view == snipcode.changes && viewItem == file-staged",
          "group": "1_stage@1"
        },
        {
          "command": "snipcode.git.markResolved",
          "when": "view == snipcode.changes && viewItem == file-conflict",
          "group": "1_stage@1"
        },
        {
          "command": "snipcode.git.stageRepo",
          "when": "view == snipcode.changes && viewItem == repo-unstaged",
          "group": "1_stage@1"
        },
        {
          "command": "snipcode.git.unstageRepo",
          "when": "view == snipcode.changes && viewItem == repo-staged",
          "group": "1_stage@1"
        },
        {
          "command": "snipcode.git.openChange",
          "when": "view == snipcode.changes && viewItem =~ /^file-/",
          "group": "2_open@1"
        },
        {
          "command": "snipcode.git.showDiff",
          "when": "view == snipcode.changes && viewItem =~ /^file-/",
          "group": "2_open@2"
        },
        {
          "command": "snipcode.git.openChangeNative",
          "when": "view == snipcode.changes && viewItem =~ /^file-/",
          "group": "2_open@3"
        },
        {
          "command": "snipcode.git.discard",
          "when": "view == snipcode.changes && viewItem == file-unstaged",
          "group": "3_discard@1"
        },
        {
          "command": "snipcode.git.discardRepo",
          "when": "view == snipcode.changes && viewItem == repo-unstaged",
          "group": "3_discard@1"
        },
        {
          "command": "snipcode.git.copyAsClipCode",
          "when": "view == snipcode.changes && viewItem =~ /^(file|repo|group)-/",
          "group": "9_copy@1"
        },
        {
          "command": "clipcode.history.copyFullSource",
          "when": "view == clipcode.history && viewItem =~ /^(commit|folder|file)$/",
          "group": "navigation@10"
        },
        {
          "command": "gitGraphPlus.checkoutBranch",
          "when": "view == gitGraphPlus.branches && viewItem == branch",
          "group": "1_branch@1"
        },
        {
          "command": "gitGraphPlus.mergeBranch",
          "when": "view == gitGraphPlus.branches && viewItem == branch",
          "group": "1_branch@2"
        },
        {
          "command": "gitGraphPlus.renameBranch",
          "when": "view == gitGraphPlus.branches && viewItem == branch",
          "group": "1_branch@3"
        },
        {
          "command": "snipcode.git.copyBranchSeries",
          "when": "view == gitGraphPlus.branches && viewItem =~ /^branch(-current)?$/",
          "group": "1_branch@4"
        },
        {
          "command": "gitGraphPlus.deleteBranch",
          "when": "view == gitGraphPlus.branches && viewItem == branch",
          "group": "2_danger@1"
        },
        {
          "command": "gitGraphPlus.checkoutRemoteBranch",
          "when": "view == gitGraphPlus.remotes && viewItem == remote-branch",
          "group": "1_branch@1"
        },
        {
          "command": "gitGraphPlus.deleteRemoteBranch",
          "when": "view == gitGraphPlus.remotes && viewItem == remote-branch",
          "group": "2_danger@1"
        },
        {
          "command": "gitGraphPlus.checkoutBranch",
          "when": "view == gitGraphPlus.tags && viewItem == tag",
          "group": "0_checkout@1"
        },
        {
          "command": "gitGraphPlus.pushTag",
          "when": "view == gitGraphPlus.tags && viewItem == tag",
          "group": "1_push@1"
        },
        {
          "command": "gitGraphPlus.deleteRemoteTag",
          "when": "view == gitGraphPlus.tags && viewItem == tag",
          "group": "2_danger@1"
        },
        {
          "command": "gitGraphPlus.deleteTag",
          "when": "view == gitGraphPlus.tags && viewItem == tag",
          "group": "2_danger@2"
        },
        {
          "command": "gitGraphPlus.stashApply",
          "when": "view == gitGraphPlus.stashes && viewItem == stash",
          "group": "1_stash@1"
        },
        {
          "command": "gitGraphPlus.stashPop",
          "when": "view == gitGraphPlus.stashes && viewItem == stash",
          "group": "1_stash@2"
        },
        {
          "command": "gitGraphPlus.stashDrop",
          "when": "view == gitGraphPlus.stashes && viewItem == stash",
          "group": "2_danger@1"
        },
        {
          "command": "gitGraphPlus.openWorktree",
          "when": "view == gitGraphPlus.worktrees && (viewItem == worktree || viewItem == worktree-main)",
          "group": "1_worktree@1"
        },
        {
          "command": "gitGraphPlus.openWorktreeInFileExplorer",
          "when": "view == gitGraphPlus.worktrees && (viewItem == worktree || viewItem == worktree-main)",
          "group": "1_worktree@2"
        },
        {
          "command": "gitGraphPlus.removeWorktree",
          "when": "view == gitGraphPlus.worktrees && viewItem == worktree",
          "group": "2_danger@1"
        }
      ],
      "commandPalette": [
        {
          "command": "snipcode.git.stage",
          "when": "false"
        },
        {
          "command": "snipcode.git.unstage",
          "when": "false"
        },
        {
          "command": "snipcode.git.stageRepo",
          "when": "false"
        },
        {
          "command": "snipcode.git.unstageRepo",
          "when": "false"
        },
        {
          "command": "snipcode.git.markResolved",
          "when": "false"
        },
        {
          "command": "snipcode.git.openChange",
          "when": "false"
        },
        {
          "command": "snipcode.git.openChangeNative",
          "when": "false"
        },
        {
          "command": "snipcode.git.showDiff",
          "when": "false"
        },
        {
          "command": "snipcode.git.copyAsClipCode",
          "when": "false"
        },
        {
          "command": "snipcode.git.discard",
          "when": "false"
        },
        {
          "command": "snipcode.git.discardRepo",
          "when": "false"
        },
        {
          "command": "gitGraphPlus.showRemoteBranchMenu",
          "when": "false"
        },
        {
          "command": "clipcode.history.loadMore",
          "when": "false"
        }
      ]
    },
    "configuration": [
      {
        "title": "Snipcode",
        "properties": {
          "clipcode.headerFormat": {
            "type": "string",
            "default": "// file: $FILE_PATH"
          },
          "clipcode.preText": {
            "type": "string",
            "default": ""
          },
          "clipcode.postText": {
            "type": "string",
            "default": ""
          },
          "clipcode.addExtraLineBetweenFiles": {
            "type": "boolean",
            "default": true
          },
          "clipcode.setMaxFileCount": {
            "type": "boolean",
            "default": true
          },
          "clipcode.fileCountLimit": {
            "type": "number",
            "default": 30
          },
          "clipcode.maxFileSizeKB": {
            "type": "number",
            "default": 500
          },
          "clipcode.showCopyNotification": {
            "type": "boolean",
            "default": true
          },
          "clipcode.useFilters": {
            "type": "boolean",
            "default": false
          },
          "clipcode.useIncludeFilters": {
            "type": "boolean",
            "default": true
          },
          "clipcode.useExcludeFilters": {
            "type": "boolean",
            "default": true
          },
          "clipcode.filterRules": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "PATH",
                    "PATTERN"
                  ]
                },
                "action": {
                  "enum": [
                    "INCLUDE",
                    "EXCLUDE"
                  ]
                },
                "value": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "action",
                "value",
                "enabled"
              ]
            }
          }
        }
      },
      {
        "title": "Git Graph+",
        "properties": {
          "gitGraphPlus.autoRefresh": {
            "type": "boolean",
            "default": true,
            "description": "Automatically refresh when repository changes are detected"
          },
          "gitGraphPlus.locale": {
            "type": "string",
            "enum": [
              "auto",
              "en",
              "ko",
              "zh-cn"
            ],
            "default": "auto",
            "description": "UI language (auto = follow VS Code language setting)"
          },
          "gitGraphPlus.timeout": {
            "type": "integer",
            "default": 60,
            "minimum": 1,
            "markdownDescription": "Maximum time (in seconds) to wait for a Git command before it is aborted."
          },
          "gitGraphPlus.initialCommitCount": {
            "type": "integer",
            "default": 200,
            "minimum": 1,
            "markdownDescription": "Number of commits loaded when the graph first renders (and on refresh)."
          },
          "gitGraphPlus.loadMoreCommitCount": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "markdownDescription": "Number of additional commits fetched each time **Load more commits** is clicked."
          },
          "gitGraphPlus.graphSortOrder": {
            "type": "string",
            "enum": [
              "author-date",
              "date",
              "topological"
            ],
            "default": "topological",
            "description": "Commit sort order in the graph"
          },
          "gitGraphPlus.showSignatureStatus": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Show a GPG/SSH signature status icon next to each commit in the graph."
          },
          "gitGraphPlus.branchBadgeBarThickness": {
            "type": "string",
            "enum": [
              "thin",
              "medium",
              "thick"
            ],
            "default": "thin",
            "description": "Thickness of the colored accent bar on the left of branch badges in the graph"
          },
          "gitGraphPlus.branchColors": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "pattern": {
                  "type": "string"
                },
                "color": {
                  "type": "string"
                }
              },
              "required": [
                "pattern",
                "color"
              ]
            },
            "markdownDescription": "Assign fixed colors to branches by name pattern in the graph."
          },
          "gitGraphPlus.graphColors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "#63b0f4",
              "#73d13d",
              "#ff7a45",
              "#b37feb",
              "#f759ab",
              "#36cfc9",
              "#ffc53d",
              "#ff4d4f",
              "#597ef7",
              "#9254de",
              "#43e8d8",
              "#faad14"
            ],
            "markdownDescription": "Color palette auto-assigned to graph rails."
          },
          "gitGraphPlus.commitMessageLinks": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "pattern": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "pattern",
                "url"
              ]
            },
            "markdownDescription": "Turn matching text in commit messages into clickable links."
          },
          "gitGraphPlus.autoDetectRepoLinks": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Automatically link references based on the `origin` remote."
          },
          "gitGraphPlus.defaults.push.force": {
            "type": "string",
            "enum": [
              "none",
              "with-lease",
              "force"
            ],
            "default": "none"
          },
          "gitGraphPlus.defaults.push.setUpstream": {
            "type": "boolean",
            "default": true
          },
          "gitGraphPlus.defaults.push.allTags": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.pull.rebase": {
            "type": "boolean",
            "default": true
          },
          "gitGraphPlus.defaults.pull.stash": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.fetch.allRemotes": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.merge.mode": {
            "type": "string",
            "enum": [
              "default",
              "no-ff",
              "squash"
            ],
            "default": "default"
          },
          "gitGraphPlus.defaults.merge.pushAfter": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.merge.deleteSource": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.rebase.autostash": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.rebase.pushAfter": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.amend.keepMessage": {
            "type": "boolean",
            "default": true
          },
          "gitGraphPlus.defaults.amend.resetDate": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.amend.resetAuthor": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.amend.only": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.amend.pushAfter": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.checkout.dirty": {
            "type": "string",
            "enum": [
              "keep",
              "stash",
              "discard"
            ],
            "default": "keep"
          },
          "gitGraphPlus.defaults.checkoutRemote.dirty": {
            "type": "string",
            "enum": [
              "keep",
              "stash",
              "discard"
            ],
            "default": "keep"
          },
          "gitGraphPlus.defaults.createBranch.checkout": {
            "type": "boolean",
            "default": true
          },
          "gitGraphPlus.defaults.createBranch.publish": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.createTag.push": {
            "type": "boolean",
            "default": true
          },
          "gitGraphPlus.defaults.cherryPick.noCommit": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.cherryPick.pushAfter": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.revert.noCommit": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.revert.pushAfter": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.reset.mode": {
            "type": "string",
            "enum": [
              "soft",
              "mixed",
              "hard"
            ],
            "default": "mixed"
          },
          "gitGraphPlus.defaults.stashSave.includeUntracked": {
            "type": "boolean",
            "default": true
          },
          "gitGraphPlus.defaults.stashSave.keepIndex": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.deleteBranch.force": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.deleteBranch.deleteRemote": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.deleteTag.deleteRemote": {
            "type": "boolean",
            "default": false
          },
          "gitGraphPlus.defaults.removeWorktree.deleteBranch": {
            "type": "boolean",
            "default": false
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test out/test/*.test.js",
    "compile:e2e": "tsc -p tsconfig.e2e.json",
    "test:e2e": "npm run build && npm run compile:e2e && node out-e2e/runTest.js",
    "test:all": "npm test && npm run test:e2e",
    "build:graph-deps": "npm ci --prefix graph --no-audit --no-fund && npm ci --prefix graph/webview-ui --no-audit --no-fund",
    "build:graph-webview": "npm run build --prefix graph/webview-ui && node scripts/copy-graph-assets.mjs",
    "build:host": "node esbuild.config.mjs",
    "build": "npm run build:graph-deps && npm run build:graph-webview && npm run build:host",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.0",
    "@types/vscode": "^1.108.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.12",
    "glob": "^11.0.0",
    "mocha": "^10.8.2",
    "typescript": "^5.7.3"
  }
}
